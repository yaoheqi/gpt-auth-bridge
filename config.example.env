# Copy to .env in the repository root. Both UI and business APIs use this file.
# Never commit real credentials. Node.js >=22.19.0 is required.
HOST=127.0.0.1
PORT=4173
# Optional Compose resource limits (Chromium and HTTP worker processes share these).
APP_MEMORY_LIMIT=6g
APP_CPU_LIMIT=4.0
# Chromium processes also create threads; allow room for ten browser helpers.
APP_PIDS_LIMIT=2048
NODE_ENV=development
# User records are stored only in the browser; the server has no persistent database.
# Optional Python executable. Defaults to root .venv, legacy .venv, then PATH.
PYTHON=

AUTH_MODE=rt
BUSINESS_WORKSPACE_IDS=
# No implicit local proxy. Set OPENAI_PROXY_URL explicitly when the server should use one.
OPENAI_PROXY_URL=
# Optional first hop: application -> this HTTP CONNECT proxy -> pool proxy.
# Local example: http://127.0.0.1:7890 (leave empty for a direct connection).
PROXY_CHAIN_URL=
YESCAPTCHA_API_KEY=
YESCAPTCHA_API_BASE_URL=https://api.yescaptcha.com
YESCAPTCHA_TURNSTILE_PREMIUM=true
OPENAI_TURNSTILE_WEBSITE_URL=https://auth.openai.com
OPENAI_TURNSTILE_SITEKEY=
# Compatibility aliases accepted for existing local .env files:
# TURNSTILE_SITEKEY= / YESCAPTCHA_SITEKEY=
TURNSTILE_BROWSER_FALLBACK=true
# Experimental: keep browser processes between tasks; contexts remain isolated.
# Shares TASK_CONCURRENCY. Idle workers close after 60s; recycle after 20 tasks.
BROWSER_REUSE_ENABLED=false
SMSBOWER_API_KEY=
SMSBOWER_API_BASE_URL=https://smsbower.page/stubs/handler_api.php
SMSBOWER_SERVICE=dr
SMSBOWER_COUNTRIES=
SMSBOWER_MAX_PRICE=0.05
SMSBOWER_NUMBER_ATTEMPTS=15
SMSBOWER_CODE_TIMEOUT_MS=40000
SMSBOWER_CODE_POLL_MS=5000
PROTOCOL_HARDENING_ENABLED=true
PROTOCOL_RANDOM_FINGERPRINT=true
PROTOCOL_FINGERPRINT_REGION=US
PROTOCOL_HUMAN_PACING=true
# Fixed global account/HTTP worker/Chromium concurrency, 1-30. Restart to apply.
# Default 10; larger values require more CPU, memory and process capacity.
# Browser settings and request bodies cannot override this value.
TASK_CONCURRENCY=10
SUB2API_BASE_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_GROUP_NAME=
SUB2API_TARGET=100
# Isolated-environment retry budget (not a concurrency setting).
SESSION_RELOGIN_MAX_ATTEMPTS=3
AUTO_DELETE_INVALID_SESSIONS=true
CODEX_AGENT_VERSION=0.145.0
CODEX_AGENT_RUNNING_LOCATION=cli-windows

# Random per-account OpenAI proxy pool.
# Leave unset for direct egress, or provide a newline/semicolon-separated
# server-side pool to override it.
APP_PROXY_POOL=
# Optional pool used only when the browser selects the built-in proxy mode.
# Store real proxy credentials in the server .env, never in source code.
# Both pools accept HTTP(S), socks5://user:pass@host:port and socks5h:// URLs.
# Separate entries with semicolons, or use a quoted multiline value.
OPENAI_BUILT_IN_PROXY_POOL=
# Required OAuth connectivity check before login; total timeout in milliseconds.
APP_PROXY_PREFLIGHT_TIMEOUT_MS=15000
# Credentials and settings entered in the UI stay in the browser.
