# Only application inputs enter the Docker build context.
# Dockerfile and .dockerignore are sent by Docker even when excluded here.
**
!package.json
!package-lock.json
!requirements.txt
!LICENSE
!AUTHORS.md
!server.js
!src/
!src/**
!docs/
!docs/**
!login-service/
!login-service/**

# Exclude local state even when it is nested inside an allowed source tree.
**/.git
**/node_modules
**/.npm
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.idea
**/.vscode
**/runtime/**
**/runtime-*/**
**/logs
**/*.log
**/*.log.*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.har

# No environment files, credentials, exports, keys, or backups in images.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.session.json
**/session*.json
**/session*.txt
**/session*.csv
**/token*.json
**/token*.txt
**/auth*.json
**/credentials*.json
**/credentials*.txt
**/credentials*.csv
**/accounts*.json
**/accounts*.txt
**/accounts*.csv
**/*.bundle
**/*.bak
**/*.tmp
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Tests and reports are checked in CI, outside the production image.
**/test
**/tests
**/*.test.js
**/*.test.mjs
**/*.spec.js
**/*.spec.mjs
**/coverage
**/playwright-report
**/test-results
